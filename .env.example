# Copy this file to .env and fill in your values.

# Required when ALLOW_MOCK_AI=false
OPENAI_API_KEY=sk-...

# Replace with any model available to your OpenAI account.
# Keep this configurable because model availability changes.
OPENAI_MODEL=gpt-5.4-mini

PORT=3000
DATA_DIR=./data

# For local testing without API calls.
ALLOW_MOCK_AI=true

# Optional: set an admin key to export data from /api/export/:table?key=...
ADMIN_EXPORT_KEY=change-me

# Research prompt used by the embedded AI assistant.
EXPERIMENT_SYSTEM_PROMPT=You are the AI assistant embedded in a user attention experiment. Help the participant complete the task clearly and neutrally. Do not ask for personal sensitive data. Keep answers concise.
